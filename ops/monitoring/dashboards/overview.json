{
  "uid": "familytracker-overview",
  "title": "FamilyTracker / HTTP & Runtime",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "familytracker",
    "local"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "familytracker-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(familytracker_http_requests_total[5m]))",
          "legendFormat": "{{route}} {{event}} {{outcome}} {{channel}} {{state}} {{reason}} {{operation}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Số request HTTP hoàn tất mỗi giây, nhóm theo route. Dùng để nhận biết lưu lượng tăng/giảm; đây là tốc độ trung bình cửa sổ 5 phút, không phải tổng request."
    },
    {
      "id": 2,
      "title": "HTTP p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "familytracker-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (route, le) (rate(familytracker_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}} {{event}} {{outcome}} {{channel}} {{state}} {{reason}} {{operation}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Phân vị 95 của thời gian xử lý HTTP theo route: 95% request nhanh hơn hoặc bằng giá trị này. Không bao gồm thời gian phía client và mạng."
    },
    {
      "id": 3,
      "title": "Resident memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "familytracker-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "familytracker_process_resident_memory_bytes",
          "legendFormat": "{{route}} {{event}} {{outcome}} {{channel}} {{state}} {{reason}} {{operation}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "RSS là lượng RAM đang được tiến trình backend giữ trong bộ nhớ. Theo dõi xu hướng và so với giới hạn RAM của container."
    },
    {
      "id": 4,
      "title": "Event loop p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "familytracker-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "familytracker_event_loop_delay_p99_seconds",
          "legendFormat": "{{route}} {{event}} {{outcome}} {{channel}} {{state}} {{reason}} {{operation}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Độ trễ event loop ở phân vị 99. Giá trị cao cho thấy JavaScript bị bận/chặn, có thể làm chậm API và Socket."
    },
    {
      "id": 5,
      "title": "CPU seconds / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "familytracker-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(familytracker_process_cpu_user_seconds_total[5m]) + rate(familytracker_process_cpu_system_seconds_total[5m])",
          "legendFormat": "{{route}} {{event}} {{outcome}} {{channel}} {{state}} {{reason}} {{operation}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Số giây CPU mà process tiêu thụ trong mỗi giây thực. Gần 1 nghĩa là xấp xỉ một lõi CPU được dùng liên tục."
    },
    {
      "id": 6,
      "title": "Scrape up",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "familytracker-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"familytracker-local\"}",
          "legendFormat": "{{route}} {{event}} {{outcome}} {{channel}} {{state}} {{reason}} {{operation}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "1 nghĩa là Prometheus lấy metrics thành công ở lần scrape gần nhất; 0 nghĩa là target không scrape được."
    }
  ]
}
