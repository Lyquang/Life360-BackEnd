NODE_ENV=development
PORT=3000
# Opt-in operational endpoint; bearer must be separate from application JWTs.
# GET /metrics supports gzip, has no CORS/Swagger exposure, and is limited to 10 scrapes/minute.
METRICS_ENABLED=false
METRICS_TOKEN=

# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/location-sharing-app?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/location-sharing-app

# Generate with: openssl rand -hex 32
JWT_SECRET=change_me
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
AUTH_MAX_ACTIVE_SESSIONS=10
# Deprecated fallback for existing deployments. Prefer JWT_ACCESS_EXPIRES_IN.
# JWT_EXPIRES_IN=7d

# Google OAuth2 client ID used to verify mobile Google ID tokens.
# GOOGLE_CLIENT_ID=1234567890-abcdef.apps.googleusercontent.com

# Comma-separated list of allowed origins, or * for all
CORS_ORIGIN=*

# Timezone used for "today" in history/journey APIs
TZ=Asia/Ho_Chi_Minh

# Optional: override public URL shown in Swagger (Render sets RENDER_EXTERNAL_URL automatically)
# PUBLIC_URL=https://family-tracker-api.onrender.com

# Optional: max login/register requests per IP per 15 minutes
# AUTH_RATE_LIMIT=20
# REFRESH_RATE_LIMIT=60

# Offline location batch sync: requests per user per minute, points per request, and max point age.
LOCATION_BATCH_RATE_LIMIT=30
LOCATION_BATCH_MAX_POINTS=100
LOCATION_BATCH_MAX_AGE_HOURS=24

# Dense realtime history is rollout-gated. Keep false until backend/indexes are deployed and verified.
LOCATION_HISTORY_DENSE_ENABLED=false
LOCATION_HISTORY_MOVING_INTERVAL_SECONDS=15
LOCATION_HISTORY_MOVING_DISTANCE_METERS=25
LOCATION_HISTORY_IDLE_INTERVAL_SECONDS=300

# Journey geometry opt-in and raw history range pagination.
JOURNEY_GAP_THRESHOLD_SECONDS=180
JOURNEY_MAX_POINTS_PER_SEGMENT=1000
JOURNEY_SIMPLIFY_TOLERANCE_METERS=8
HISTORY_RANGE_DEFAULT_LIMIT=500
HISTORY_RANGE_MAX_LIMIT=1000
HISTORY_RANGE_MAX_DAYS=7

# Live trail persistence foundation. Keep disabled until privacy/member-removal hooks and load gates pass.
LIVE_TRAIL_ENABLED=false
LIVE_TRAIL_RETENTION_DAYS=7
LIVE_TRAIL_MAX_ACCURACY_METERS=100
LIVE_TRAIL_READ_RATE_LIMIT=60
LIVE_TRAIL_MAX_WATCHES_PER_SOCKET=5
LIVE_TRAIL_WATCH_ACTIONS_PER_MINUTE=30
LIVE_TRAIL_WATCH_LEASE_SECONDS=60
LIVE_TRAIL_DELTA_MAX_POINTS=50
LIVE_TRAIL_DELTA_MAX_BYTES=65536
LIVE_TRAIL_DELTA_FLUSH_MS=2000

# Provider-neutral matcher pipeline. Keep disabled; fake is test-only and rejected in production.
LIVE_TRAIL_MATCHER_ENABLED=false
LIVE_TRAIL_MATCHER_PROVIDER=noop
# Set provider=mapbox and provide this server-side secret to enable real road matching.
# Never ship the token to the iOS app or log the request URL (it contains GPS and token).
MAPBOX_ACCESS_TOKEN=
LIVE_TRAIL_MATCH_MIN_CONFIDENCE=0.6
LIVE_TRAIL_MATCH_WINDOW_SIZE=5
LIVE_TRAIL_MATCH_WINDOW_WAIT_SECONDS=30
LIVE_TRAIL_MATCH_OVERLAP_POINTS=2
LIVE_TRAIL_MATCH_FUTURE_CONTEXT_POINTS=2
LIVE_TRAIL_MATCH_MIN_POINTS=3
LIVE_TRAIL_MATCH_MAX_ACCURACY_METERS=50
LIVE_TRAIL_MATCH_QUEUE_MAX_TRAILS=100
LIVE_TRAIL_MATCH_CONCURRENCY=1
LIVE_TRAIL_MATCH_TIMEOUT_MS=1000
# For the Mapbox provider, use about 5000 ms initially and tune against real latency.
LIVE_TRAIL_MATCH_CIRCUIT_FAILURES=3
LIVE_TRAIL_MATCH_CIRCUIT_COOLDOWN_SECONDS=30

# ─── Redis cache/session/location (recommended: Upstash Redis) ───
# Leave REDIS_ENABLED=false to run without Redis; the app falls back to MongoDB/no-op cache.
REDIS_ENABLED=false
# REDIS_URL=rediss://default:<password>@<host>:<port>
REDIS_KEY_PREFIX=familytracker:
REDIS_DEFAULT_TTL_SECONDS=300
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES_PER_REQUEST=2
REDIS_LOCATION_TTL_SECONDS=300

# ─── Media upload (preferred: Cloudflare R2) ───
# Leave all unset to disable image/voice uploads (upload-ticket returns 503).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=family-tracker-media
# R2_PUBLIC_DOMAIN=https://media.example.com
# R2_REGION=auto
# R2_UPLOAD_URL_TTL_SECONDS=300
# R2_IMAGE_MAX_BYTES=10485760
# R2_VOICE_MAX_BYTES=26214400

# ─── Legacy S3-compatible config (AWS S3 / R2 / MinIO) ───
# Cloudflare R2 legacy style: S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com, S3_REGION=auto
# AWS S3:                  leave S3_ENDPOINT empty, S3_REGION=ap-southeast-1
# S3_BUCKET=family-tracker-media
# S3_REGION=auto
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Public base URL where uploaded files are readable (R2 public bucket / custom domain / CloudFront)
# S3_PUBLIC_BASE_URL=https://media.example.com
# S3_FORCE_PATH_STYLE=false
# UPLOAD_MAX_BYTES=10485760
# UPLOAD_URL_TTL_SECONDS=300
## SOS outbox worker (experimental; leave disabled until SOS REST/socket integration).
SOS_OUTBOX_ENABLED=false
SOS_OUTBOX_POLL_MS=1000
SOS_OUTBOX_BATCH_SIZE=20
SOS_OUTBOX_LEASE_MS=30000
SOS_OUTBOX_MAX_ATTEMPTS=5
SOS_OUTBOX_RETRY_BASE_MS=1000
SOS_OUTBOX_RETRY_MAX_MS=60000
## SOS REST API (experimental; requires outbox enabled and MongoDB transactions).
SOS_API_ENABLED=false
SOS_MAX_GROUPS=10
SOS_MAX_RECIPIENTS=100
SOS_MAX_OUTBOX_EVENTS=300
SOS_RATE_LIMIT=60
