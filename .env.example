NODE_ENV=development
PORT=3000

# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/location-sharing-app?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/location-sharing-app

# Generate with: openssl rand -hex 32
JWT_SECRET=change_me
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
AUTH_MAX_ACTIVE_SESSIONS=10
# Deprecated fallback for existing deployments. Prefer JWT_ACCESS_EXPIRES_IN.
# JWT_EXPIRES_IN=7d

# Google OAuth2 client ID used to verify mobile Google ID tokens.
# GOOGLE_CLIENT_ID=1234567890-abcdef.apps.googleusercontent.com

# Comma-separated list of allowed origins, or * for all
CORS_ORIGIN=*

# Timezone used for "today" in history/journey APIs
TZ=Asia/Ho_Chi_Minh

# Optional: override public URL shown in Swagger (Render sets RENDER_EXTERNAL_URL automatically)
# PUBLIC_URL=https://family-tracker-api.onrender.com

# Optional: max login/register requests per IP per 15 minutes
# AUTH_RATE_LIMIT=20
# REFRESH_RATE_LIMIT=60

# ─── Redis cache/session/location (recommended: Upstash Redis) ───
# Leave REDIS_ENABLED=false to run without Redis; the app falls back to MongoDB/no-op cache.
REDIS_ENABLED=false
# REDIS_URL=rediss://default:<password>@<host>:<port>
REDIS_KEY_PREFIX=familytracker:
REDIS_DEFAULT_TTL_SECONDS=300
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES_PER_REQUEST=2
REDIS_LOCATION_TTL_SECONDS=300

# ─── Media upload (preferred: Cloudflare R2) ───
# Leave all unset to disable image/voice uploads (upload-ticket returns 503).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=family-tracker-media
# R2_PUBLIC_DOMAIN=https://media.example.com
# R2_REGION=auto
# R2_UPLOAD_URL_TTL_SECONDS=300
# R2_IMAGE_MAX_BYTES=10485760
# R2_VOICE_MAX_BYTES=26214400

# ─── Legacy S3-compatible config (AWS S3 / R2 / MinIO) ───
# Cloudflare R2 legacy style: S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com, S3_REGION=auto
# AWS S3:                  leave S3_ENDPOINT empty, S3_REGION=ap-southeast-1
# S3_BUCKET=family-tracker-media
# S3_REGION=auto
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Public base URL where uploaded files are readable (R2 public bucket / custom domain / CloudFront)
# S3_PUBLIC_BASE_URL=https://media.example.com
# S3_FORCE_PATH_STYLE=false
# UPLOAD_MAX_BYTES=10485760
# UPLOAD_URL_TTL_SECONDS=300
