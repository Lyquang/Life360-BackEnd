{
  "name": "location-sharing-backend",
  "version": "1.0.0",
  "description": "Real-time location sharing backend with Socket.io, MongoDB, JWT Auth",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-concurrency=1 $(find tests -name '*.test.js' | sort)",
    "lint": "node --check server.js $(find src -name '*.js' | tr '\\n' ' ')",
    "seed": "node scripts/seed-fake-user.js",
    "context:skeleton": "node scripts/codebase-skeleton.js",
    "context:graph": "npm run context:skeleton && node scripts/codebase-graph-html.js",
    "context:trace": "node scripts/trace-flow.js",
    "context:refresh": "npm run context:skeleton",
    "benchmark:live-trail": "node scripts/benchmark-live-trail.js",
    "monitoring:init": "node scripts/monitoring-local.js init",
    "monitoring:up": "node scripts/monitoring-local.js up",
    "monitoring:down": "node scripts/monitoring-local.js down",
    "monitoring:status": "node scripts/monitoring-local.js status",
    "monitoring:validate-alerts": "node scripts/validate-monitoring-alerts.js",
    "benchmark:monitoring": "node scripts/benchmark-monitoring.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.220.0",
    "@opentelemetry/sdk-node": "0.220.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "pino": "10.1.0",
    "prom-client": "15.1.3",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "socket.io-client": "^4.8.4"
  }
}
